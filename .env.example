# Copy to .env and fill in. Never commit .env.

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Sandbox personal (buyer) account, used to approve orders and open disputes in the sandbox UI
PAYPAL_SANDBOX_BUYER_EMAIL=
# Saved sandbox-buyer wallet: run `python -m scripts.vault setup`, approve, then `finish`.
# When set, agent purchases are charged with no buyer redirect. Blank = approval redirect.
PAYPAL_VAULT_ID=

# Webhook id from developer.paypal.com > your app > Webhooks (subscribe to CUSTOMER.DISPUTE.*).
PAYPAL_WEBHOOK_ID=
# true = dispute webhooks file responses with PayPal (accept claim / evidence / adjudicate).
# Leave false while pre-staged demo disputes must stay open.
DISPUTE_AUTO_FILE=false
# Master switch for filing anything with PayPal (resolve?file=true, webhook auto-file, CLI --file).
# Off = 403 on filing routes and the UI shows "Would file: <action>". Turn on only locally,
# for the recording-prep sitting. Never on Render.
FILING_ENABLED=false

# Demo cost guard on /shop, scenario runs and dispute resolve (they call Claude / place orders).
# Runs per minute per visitor, and runs per UTC day for everyone. 0 = no limit.
RATE_LIMIT_PER_MINUTE=3
RATE_LIMIT_PER_DAY=150

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Where PayPal sends the buyer after approval (Render URL in prod)
# Public URL of this backend (PayPal return/cancel links). On Render, leave unset: RENDER_EXTERNAL_URL is used.
APP_BASE_URL=http://localhost:8001

# Receipts ledger. sqlite:/// only; relative paths resolve against
# the repo root, so the API server and the MCP server share one file.
DATABASE_URL=sqlite:///./agent_receipts.db
