          "raw": "{{base_url}}/disputes?live=false",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "disputes"
          ],
          "query": [
            {
              "key": "live",
              "value": "false"
            }
          ]
        },
        "description": ""
      }
    },
    {
      "name": "Resolve dispute (no filing)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/disputes/{{dispute_id}}/resolve?file=false",
          "host": [
            "{{base_url}}"
          ],
